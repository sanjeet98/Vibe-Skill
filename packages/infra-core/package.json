{
  "name": "@vibe-skill/infra-core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vibe-skill/manifest": "workspace:*",
    "dotenv": "^18.0.9",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vibe-skill/tsconfig": "workspace:*",
    "tsup": "^9.0.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
